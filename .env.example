# Backend Environment Variables
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/qmed?retryWrites=true&w=majority
SECRET_KEY=generate_a_strong_secret_key_here
GROQ_API_KEY=your_groq_api_key_here

# Application Settings
ENVIRONMENT=production # or development
PORT=8000
ALLOWED_ORIGINS=http://localhost,http://your-domain.com

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
